# Copy to .env and replace placeholders. NEVER commit .env.
APP_ENV=development
APP_NAME=FinSight AI
API_V1_PREFIX=/api/v1

POSTGRES_USER=finsight
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=finsight
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: overrides the individual POSTGRES_* values above
# DATABASE_URL=postgresql+psycopg://finsight:change_me_locally@localhost:5432/finsight

# Used from Milestone 2 onward
JWT_SECRET_KEY=replace_with_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
